# 실제 호출 모드입니다. mock이면 외부 API를 호출하지 않습니다.
AI_MODE=openai
PORT=8002
ENABLE_VOICE_DEMO=1

# 기능별 공급자 선택. TTS는 크레딧 없이 실행할 수 있도록 기본 비활성화합니다.
TEXT_PROVIDER=groq
STT_PROVIDER=groq
IMAGE_PROVIDER=cloudflare
VISION_PROVIDER=groq
TTS_PROVIDER=disabled

# 대화·일기·장면 구성, 음성 인식, 이미지 검토에 공통 사용합니다.
GROQ_API_KEY=
GROQ_TEXT_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# Cloudflare Workers AI: 계정 ID와 Workers AI 실행 권한이 있는 API 토큰입니다.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# 선택 기능: 한국어 음성 출력을 켜려면 TTS_PROVIDER=openai로 바꿉니다.
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# 공급자를 openai로 선택했을 때만 사용합니다.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_VISION_MODEL=gpt-4.1-mini
