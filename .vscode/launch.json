{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "name": "AI 서버: 체험 모드 (API 비용 없음)",
      "env": {
        "AI_MODE": "mock",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    },
    {
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/server.py",
      "python": "${workspaceFolder}/.venv/bin/python",
      "windows": {
        "python": "${workspaceFolder}/.venv/Scripts/python.exe"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true,
      "name": "AI 서버: 실제 AI (.env 설정)",
      "env": {
        "AI_MODE": "openai",
        "PYTHONDONTWRITEBYTECODE": "1"
      }
    }
  ]
}
